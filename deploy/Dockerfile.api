# Serveur SENTINELLE (API + superviseur). Utilisateur non-root, pas de secrets dans l'image.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 sentinelle
WORKDIR /app
COPY pyproject.toml README.md ./
COPY sentinelle ./sentinelle
COPY scripts ./scripts
RUN pip install --no-cache-dir . uvicorn fastapi
USER sentinelle
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"
CMD ["uvicorn", "sentinelle.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
