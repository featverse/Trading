# Copier en deploy/.env, remplir, puis : chmod 600 deploy/.env
# Ce fichier n'est JAMAIS commité (voir .gitignore).

# --- Serveur SENTINELLE (générer avec : python scripts/hash_password.py) ---
SENTINELLE_PASSWORD_HASH=
SENTINELLE_TOKEN_SECRET=
SENTINELLE_INTERNAL_TOKEN=
SENTINELLE_DOMAIN=
SENTINELLE_USDT_FCFA=600
SENTINELLE_INITIAL_FCFA=20000
SENTINELLE_MONTHLY_FCFA=20000

# --- Recherche (agents IA) ---
ANTHROPIC_API_KEY=

# --- Freqtrade : API locale (générer : openssl rand -hex 24) ---
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# --- Alertes Telegram (optionnel) ---
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- Clés Binance : NE PAS REMPLIR pendant le dry-run ---
# Au passage en réel : "lecture + trading spot" uniquement, RETRAIT DÉSACTIVÉ,
# liste blanche d'IP = IP du VPS.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
